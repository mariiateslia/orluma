# The URL teammates use to open Orluma. Use HTTPS behind your reverse proxy.
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# The first account can register. Subsequent accounts need a workspace invitation.
REGISTRATION_MODE=invite
# Set to 1 only when running behind a trusted reverse proxy.
TRUST_PROXY=0
NODE_ENV=production
