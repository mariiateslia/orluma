# Same origin for the frontend, API and authentication callback links.
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# For native Node development; Docker Compose uses postgres:5432 internally.
DATABASE_URL=postgresql://orluma:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5433/orluma
POSTGRES_PASSWORD=
# Generate once with npm run setup:local; retain across deploys and backups.
AUTH_SECRET=
MAIL_FROM=Orluma <no-reply@orluma.test>
# Local inbox only. Production: set RESEND_API_KEY + a verified MAIL_FROM instead.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=
REGISTRATION_MODE=invite
# Required for an HTTPS invite-only deployment; only this email can bootstrap it.
BOOTSTRAP_EMAIL=
# Only set behind a trusted single reverse proxy; Render uses 1.
TRUST_PROXY=0
NODE_ENV=production
